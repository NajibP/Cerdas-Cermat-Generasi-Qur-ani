function setLockState(k,open){
  const L=getLocks();
  if(k==='all'){
    L.all=!!open;
    if(!open)delete L.all;
  }else{
    if(L.all&&!open){
      ['boss','epilog','t4','t5'].forEach(key=>{L[key]=true});
      delete L.all;
    }
    L[k]=!!open;
  }
  store.set('locks',L);
  syncNavLocks();
  renderDock();
}
