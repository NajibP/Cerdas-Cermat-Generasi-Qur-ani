    <div class="grid">${PES_B.map((b,i)=>{const d=isBundleUsed('peserta',i);return `<button class="card pop mode ${d?'locked':''}" data-b="${i}" ${d?'disabled':''}><span class="ic">${d?'🔒':b[0]}</span><span><h3>${b[1]}</h3><span class="tag ${d?'':'mudah'}">${d?'terkunci 🔒':'Mudah'}</span> <span class="tag">${d?'sudah dipilih':'10 soal'}</span></span></button>`}).join('')}</div>
