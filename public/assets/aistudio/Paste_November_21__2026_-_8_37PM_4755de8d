function renderDock(){
  const ic=['','🐢','🚶','🏃','🔥','🕊️'];
  $$('[data-music-box]').forEach(box=>{
    const lbl=$('[data-m-label]',box);
    if(lbl)lbl.textContent=`♪ ${Music.cur?Music.T[Music.cur].n:'Pilih musik'}${Music.muted?' (jeda)':''}`;
    [1,2,3,4,5].forEach(n=>{
      const btn=$(`[data-trk="${n}"]`,box);
      if(!btn)return;
      const lk=!trackOpen(n);
      btn.classList.toggle('lk',lk);
      btn.setAttribute('aria-pressed',String(Music.cur===n&&Music.playing));
      btn.setAttribute('aria-label',`Track ${n}${lk?' terkunci':''}`);
      btn.innerHTML=`${lk?'🔒':ic[n]}<small> ${n}</small>`;
    });
    const tgl=$(`[data-trk="toggle"]`,box);
    if(tgl)tgl.textContent=Music.playing?'⏸':'▶️';
    const sl=$('[data-m-vol]',box);
    if(sl)sl.value=String(Music.vol);
  });
}

