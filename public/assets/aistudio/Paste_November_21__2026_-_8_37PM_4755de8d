// Final Boss: Iblis
const BOSS_SPECS=[{mudah:1,sedang:3,sulit:1},{sedang:4,sulit:1},{mudah:1,sedang:2,sulit:2}];
const ENDINGS=[
  {t:'Penjaga Cahaya Qur\'ani',e:'👑',x:'Saat Iblis runtuh, langit kota terbelah oleh cahaya lembut. Namamu dibacakan di menara masjid sebagai penjaga cahaya Qur\'ani. Anak-anak berbaris membawa mushaf kecil, dan untuk pertama kalinya kota itu hening, lalu bergemuruh doa syukur. Kamu tahu, kekuatan terbesarmu bukan jawaban yang cepat, tapi hati yang tetap belajar.'},
  {t:'Perisai Kota',e:'🛡️',x:'Ketika Iblis mengamuk, kamulah yang berdiri paling depan. Setiap jawabanmu menjadi perisai bagi warga di belakang. Setelah badai reda, mereka membangun gerbang kota dan mengukir namamu di sana: Perisai Kota, pelindung yang sabar dan teguh.'},
  {t:'Penjaga Gerbang Hikmah',e:'🗝️',x:'Tanpa kamu, gerbang hikmah tak akan terbuka tepat waktu. Satu jawaban benarmu di saat genting memberi celah bagi tim untuk menang. Warga menyerahkan kunci perpustakaan kota kepadamu. Mulai hari ini, kamu penjaga ilmu bagi generasi berikutnya.'}];
screens.boss=()=>{
  const fin=boardGet().peserta.slice(0,3);
  if(!fin.length){toast('Belum ada peserta di papan skor');return go('hub')}
  unlock('t4');Music.auto(4);
  app.innerHTML=`<div class="stack center"><div class="card pop slide"><div class="big">🐲</div><h2>Final Boss: Iblis</h2>
    <p style="max-width:52ch">Tiga peringkat teratas maju bersama. Bergiliran sesuai peringkat, tiap pahlawan memilih 1 soal. Ada 3 bundle, 5 soal per bundle, soal mudah sampai sulit terbuka.</p>
    <div class="row" style="justify-content:center">${fin.map((p,i)=>`<span class="pill">${['🥇','🥈','🥉'][i]} ${AV(p.av,26)} ${esc(p.name)}</span>`).join('')}</div>
    <button class="btn lg coral" id="bg">⚔️ Hadapi Iblis</button></div></div>`;
  $('#bg').onclick=()=>runBoss(fin.map((p,i)=>({name:p.name,av:p.av,rank:i+1,score:0,correct:0,answered:0,time:0})));
};
function runBoss(pl){
  const run=++S.gameRun;
  const m=pl.length;let t=0,bi=0,hits=0,miss=0,wr=0,ults=0,busy=false,koDone=false,qs,st,h=null;
  setInGame(true,()=>{if(h)h.stop()});
  const used=S.used;
  const load=()=>{qs=pick(BOSS_SPECS[bi],used).map(prep);st=Array(5).fill(null)};
  const hpB=()=>Math.max(0,100-hits*10);
  const hpP=()=>Math.max(0,100-miss*100/6-ults*25);
  const draw=()=>{
    if(!isRunValid(run))return;
    const p=pl[t%m];
    app.innerHTML=`<div class="stack">
      <div class="hud"><span class="pill">Bundle ${bi+1}/3</span><span class="pill tnum">Soal ${t+1}/15</span><button class="btn coral sm" id="exit-game">🚪 Keluar</button></div>
      ${stageHTML({mega:true,av:p.av,hname:'Tim Pahlawan',kname:'Iblis',hpH:hpP(),hpK:hpB()})}
      <div class="row">${pl.map((q,i)=>`<span class="pill ${i===t%m?'hot':''}">${['🥇','🥈','🥉'][i]} ${AV(q.av,26)} ${esc(q.name)} · ${q.score}</span>`).join('')}</div>
      <div class="muted small">Giliran <b>${esc(p.name)}</b>: pilih 1 nomor soal.</div>
      <div class="tiles" id="tl">${qs.map((_,i)=>`<button class="tile ${st[i]?(st[i]==='correct'?'ok':st[i]==='wrong'?'no':'to'):''}" data-i="${i}" ${st[i]||koDone?'disabled':''}>${st[i]?(st[i]==='correct'?'✓':st[i]==='wrong'?'✗':'⏱'):i+1}</button>`).join('')}</div>
      <div class="card" id="qh"><p class="muted center">${esc(p.name)}, pilih satu soal. ⏱ 60 detik.</p></div></div>`;
    $('#tl').onclick=async e=>{
      if(koDone)return;
      const b=e.target.closest('.tile');if(!b||busy||b.disabled)return;const i=+b.dataset.i;if(isNaN(i)||i<0||i>=5||st[i]!==null)return;
      busy=true;$$('.tile').forEach(x=>x.disabled=true);b.classList.add('on');
      h=ask($('#qh'),qs[i],{seconds:60});
      const r=await h.promise;if(!isRunValid(run))return;busy=false;
      let pts,msg;
      p.answered++;
      if(r.status==='correct'){pts=100;hits++;wr=0;p.correct++;Music.sfx('hit');msg=['ok','Benar! +100. Iblis terkena serangan!']}
      else if(r.status==='wrong'){pts=-50;miss++;wr++;Music.sfx('roar');msg=['no','Belum tepat. −50']}
      else{pts=-100;miss++;wr++;Music.sfx('roar');msg=['no','Waktu habis. −100']}
      p.score+=pts;p.time+=r.elapsed;st[i]=r.status;
      if(r.status==='correct'&&!isHeroKO()){hits===10?ultHero():fxHero()}else if(r.status!=='correct'){if(wr>=5){wr=0;ults++;ultEnemy(-1)}else fxKaiju(-1)}
      $('#hk').style.width=hpB()+'%';$('#hh').style.width=hpP()+'%';
      $('#qh').insertAdjacentHTML('beforeend',`<div class="fb ${msg[0]}" style="margin-top:12px">${msg[1]}</div>`);

      if(hpB()<=0){
        koDone=true;
        const remInBundle=st.filter(v=>v===null).length;
        const remFutureBundles=Math.max(0,(2-bi)*5);
        const remTotal=remInBundle+remFutureBundles;
        const bonus=remTotal*100;
        p.score+=bonus;
        setTimeout(fxKO,hits===10&&r.status==='correct'?1100:250);
        setTimeout(fxWin,hits===10&&r.status==='correct'?1300:450);
        $('#qh').insertAdjacentHTML('beforeend',`<div class="fb ok" style="margin-top:8px">🏆 Iblis KO! Bonus ${remTotal} sisa soal: +${bonus} poin!</div>`);
        await sleep(1800);if(!isRunValid(run))return;return endBoss();
      }

      if(hpP()<=0){
        koDone=true;
        fxHeroKO();
        const remInBundle=st.filter(v=>v===null).length;
        const remFutureBundles=Math.max(0,(2-bi)*5);
        const remTotal=remInBundle+remFutureBundles;
        const pen=-(remTotal*100);
        p.score+=pen;
        $('#qh').insertAdjacentHTML('beforeend',`<div class="fb no" style="margin-top:8px">💀 Tim Pahlawan KO! ${remTotal} sisa soal dikunci (${pen} poin).</div>`);
        await sleep(1800);if(!isRunValid(run))return;return endBoss();
      }

      t++;await sleep(1700);if(!isRunValid(run))return;
      if(t>=15)return endBoss();
      if(st.every(Boolean)){bi++;load();toast('Bundle '+(bi+1)+' dimulai!')}
      draw();
    };
  };
  function endBoss(){
    if(!isRunValid(run))return;
    Music.auto(5);afterFinish();
    const win=hits>=10||hpB()<=0;setTimeout(()=>Music.sfx('cheer'),1500);if(win){Music.sfx('win');confetti(['👑','🎉','🌟','🏆'])}
    const rk=pl.slice().sort((a,b)=>b.score-a.score||a.time-a.time||a.rank-a.rank);
    unlock('boss');
    rk.forEach((p,i)=>boardAdd('regu',{name:p.name,av:p.av,score:p.score,mode:`Final Boss · Juara ${i+1}`}));
    app.innerHTML=`<div class="stack"><div class="card pop slide center"><div class="big">${win?'🏆':'🌅'}</div><h2>${win?'Iblis tumbang!':'Iblis mundur ke kegelapan'}</h2>
      <p style="max-width:52ch">${win?'Kota Qur\'ani selamat berkat kerja sama tiga pahlawan.':'Kota selamat untuk saat ini. Warga menyemangati: “Kalian sudah berjuang luar biasa, kita siap lagi besok.”'}</p>
      <span class="pill">${hits} serangan tepat</span></div>
      ${podiumHTML(rk.map(p=>({name:p.name,av:p.av,sc:p.score,t:p.time})))}${crowdHTML()}<h2>Secret Ending Sang Juara</h2>
      ${rk.map((p,i)=>`<div class="card"><div class="row"><span class="pill">${['🥇 Juara 1','🥈 Juara 2','🥉 Juara 3'][i]}</span><b>${AV(p.av,26)} ${esc(p.name)}</b><span class="pill">Skor ${p.score}</span><span class="pill">Benar ${p.correct}/${p.answered||5} (${pct(p.correct,p.answered||5)}%)</span></div>
        <h3 style="margin-top:10px">${ENDINGS[i].e} ${ENDINGS[i].t}</h3><p>${ENDINGS[i].x}</p>
        <button class="btn sun sm" data-c="${i}">🎓 Sertifikat ${esc(p.name)}</button></div>`).join('')}
      <div class="row"><button class="btn" data-go="board">🏆 Papan skor</button><button class="btn ghost" data-go="hub">Menu</button></div></div>`;
    app.onclick=e=>{const b=e.target.closest('[data-c]');if(!b)return;const idx=+b.dataset.c,p=rk[idx];if(!p)return;
      const denom=p.answered||5;
      S.cert={name:p.name,av:p.av,score:p.score,nilai:pct(p.correct,denom),time:p.time,title:ENDINGS[idx].t,sub:`Final Boss · Juara ${idx+1} (${p.correct}/${denom} benar)`,win:true};go('cert')};
  }
  load();draw();
}

// Regu Duel dan Turnamen 1vs1 Lintas Kelas
const waitFor=(sel,run)=>new Promise(r=>{const el=$(sel);if(el)el.onclick=()=>{if(run==null||isRunValid(run))r()}});
screens.regu=()=>{
  app.innerHTML=`<div class="stack"><h2>🛡️ Regu Duel</h2><p class="muted">Dua regu beradu dalam 3 babak: Starter Point, Rebutan, dan Final. Seri? Lanjut Sudden Death.</p>
