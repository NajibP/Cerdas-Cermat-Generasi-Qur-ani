function pairCross(pl){
  let pool=shuffle(pl),out=[];
  while(pool.length){const a=pool.shift();let j=pool.findIndex(p=>p.k!==a.k);if(j<0)j=0;out.push([a,pool.splice(j,1)[0]])}
  return out;
}
async function runTour(pl){
  const run=++S.gameRun;
  let curAsk=null;
  setInGame(true,()=>{if(curAsk)curAsk.stop()});
  const n=pl.length,names=n===8?['Perempat Final','Semifinal','Final']:['Semifinal','Final'];
  const specs=n===8?[{mudah:5},{mudah:2,sedang:3},{sedang:5}]:[{mudah:5},{sedang:5}];
  const bgm=n===8?[3,3,4]:[2,4];
  let rounds=[pairCross(pl).map(([a,b])=>({a,b,w:null,sa:null,sb:null}))];
  for(let r=1;r<names.length;r++)rounds.push(Array.from({length:rounds[r-1].length/2},()=>({a:null,b:null,w:null})));
  const tourUsed=new Set();let lastT=0;
  const bracket=(cur)=>{
    const R=rounds.length;
    const mt=(m,ri,mi,cls)=>`<div class="mt ${cls} ${cur&&cur[0]===ri&&cur[1]===mi?'cur':''}">${[m.a,m.b].map((p,k)=>p?`<div class="pl ${m.w?(m.w===p?'w':'l'):''}">${AV(p.av,26)} ${esc(p.name)}<em>${esc(p.k)}${m.w&&m.sa!=null?' · '+(k?m.sb:m.sa):''}</em></div>`:`<div class="pl muted">menunggu…</div>`).join('')}</div>`;
    const col=(ri,sd)=>{
      const rd=rounds[ri],half=rd.length/2,idx=Array.from({length:half},(_,i)=>i+(sd==='R'?half:0));
      const ms=idx.map(mi=>mt(rd[mi],ri,mi,(ri>0?'in ':'')+'h'));
      let body;
      if(ri<R-2){const g=[];for(let i=0;i<ms.length;i+=2)g.push(`<div class="pr">${ms[i]}${ms[i+1]||''}</div>`);body=g.join('')}else body=ms.join('');
      return `<div class="rc"><h4>${names[ri]}</h4><div class="mg">${body}</div></div>`;
    };
    const fin=rounds[R-1][0];
    const mid=`<div class="mid"><h4>${names[R-1]}</h4><svg class="trophy" viewBox="0 0 90 100" aria-label="Trofi"><path d="M22 14 H68 V44 Q68 66 45 70 Q22 66 22 44Z" fill="#FFC800" stroke="#E5A800" stroke-width="3"/><path d="M22 22 H10 Q8 42 24 44 M68 22 H80 Q82 42 66 44" fill="none" stroke="#E5A800" stroke-width="4" stroke-linecap="round"/><rect x="40" y="70" width="10" height="12" fill="#E5A800"/><rect x="24" y="82" width="42" height="10" rx="4" fill="#B8860B"/><path d="M45 28 L49 38 L60 38 L51 44 L54 55 L45 48 L36 55 L39 44 L30 38 L41 38Z" fill="#FFF7CC"/></svg>${mt(fin,R-1,0,'fin')}</div>`;
    const left=Array.from({length:R-1},(_,ri)=>col(ri,'L')).join('');
    const right=Array.from({length:R-1},(_,ri)=>col(ri,'R')).reverse().join('');
    return `<div class="br"><div class="side L">${left}</div>${mid}<div class="side R">${right}</div></div>`;
  };
  let champ=null;
  for(let r=0;r<rounds.length;r++){
    if(!isRunValid(run))return;
    if(bgm[r]===4)unlock('t4');Music.auto(bgm[r]);
    for(let m=0;m<rounds[r].length;m++){
      if(!isRunValid(run))return;
      const mt=rounds[r][m];
      app.innerHTML=`<div class="stack"><div class="hud"><h2>${names[r]}</h2><button class="btn coral sm" id="exit-game">🚪 Keluar</button></div>${bracket([r,m])}<div class="card center"><p><b>${AV(mt.a.av,26)} ${esc(mt.a.name)}</b> (${esc(mt.a.k)}) vs <b>${AV(mt.b.av,26)} ${esc(mt.b.name)}</b> (${esc(mt.b.k)})</p><button class="btn lg" id="mg">Mulai pertandingan</button></div></div>`;
      await waitFor('#mg',run);if(!isRunValid(run))return;
      const qs=pick(specs[r],tourUsed).map(prep);
      const runSide=async p=>{
        let sc=0,tTot=0;
        for(let q=0;q<5;q++){
          if(!isRunValid(run))return {sc,tTot};
          app.innerHTML=`<div class="stack"><div class="hud"><span class="pill">${names[r]}</span><span class="pill">${AV(p.av,26)} ${esc(p.name)}</span><span class="pill tnum">Skor ${sc}</span><button class="btn coral sm" id="exit-game">🚪 Keluar</button></div><div class="card" id="qh"></div></div>`;
          curAsk=ask($('#qh'),qs[q],{seconds:15});
          const res=await curAsk.promise;if(!isRunValid(run))return {sc,tTot};
          tTot+=res.elapsed;
          if(res.status==='correct'){sc+=100;Music.sfx('ok');$('#qh').insertAdjacentHTML('beforeend','<div class="fb ok" style="margin-top:12px">Benar! +100</div>')}
          else{sc-=50;Music.sfx('no');$('#qh').insertAdjacentHTML('beforeend',`<div class="fb no" style="margin-top:12px">${res.status==='wrong'?'Belum tepat':'Waktu habis'}. −50</div>`)}
          await sleep(1100);
        }
        return {sc,tTot};
      };
      const A=await runSide(mt.a);if(!isRunValid(run))return;
      const B=await runSide(mt.b);if(!isRunValid(run))return;
      let w=mt.a,tW=A.tTot;
      if(B.sc>A.sc||(B.sc===A.sc&&B.tTot<A.tTot)){w=mt.b;tW=B.tTot}
      else if(B.sc===A.sc&&B.tTot===A.tTot&&Math.random()<.5){w=mt.b;tW=B.tTot}
      mt.w=w;mt.sa=A.sc;mt.sb=B.sc;lastT=tW;
      const loser=w===mt.a?mt.b:mt.a;
      if(r+1<rounds.length){const nxt=rounds[r+1][m>>1];if(m%2===0)nxt.a=w;else nxt.b=w}else champ=w;
      app.innerHTML=`<div class="stack"><div class="hud"><h2>${names[r]}</h2><button class="btn coral sm" id="exit-game">🚪 Keluar</button></div>${bracket()}<div class="card center"><h3>Pemenang: ${AV(w.av,26)} ${esc(w.name)} (${esc(w.k)})</h3><p class="muted">Skor ${esc(mt.a.name)} ${A.sc} · ${esc(mt.b.name)} ${B.sc}. Semangat terus untuk ${esc(loser.name)}!</p><button class="btn" id="nx">Lanjut →</button></div></div>`;
      await waitFor('#nx',run);if(!isRunValid(run))return;
    }
  }
  Music.auto(5);afterFinish();Music.sfx('win');confetti(['🏆','🎉','🌟','🏟️']);setTimeout(()=>Music.sfx('cheer'),1500);
  boardAdd('regu',{name:champ.name,av:champ.av,score:0,mode:`Juara Turnamen (${champ.k})`});
  S.cert={name:champ.name,av:champ.av,score:null,nilai:null,time:lastT,title:'Juara Turnamen 1vs1',sub:`Kelas ${champ.k} · ${n} pemain lintas kelas`,win:true};
  app.innerHTML=`<div class="stack center"><div class="card pop slide"><div class="big">🏆</div><h2>Juara: ${AV(champ.av,26)} ${esc(champ.name)}!</h2>
    <p style="max-width:52ch">Selamat kepada ${esc(champ.name)} dari kelas ${esc(champ.k)}! Semua peserta sudah bertanding dengan sportif dan penuh semangat.</p>${crowdHTML()}</div>
    ${bracket()}<div class="row" style="justify-content:center"><button class="btn sun" data-go="cert">🎓 Sertifikat</button><button class="btn" data-go="board">🏆 Papan skor</button><button class="btn ghost" data-go="hub">Menu</button></div></div>`;
}

// Podium, Papan Skor, Sertifikat PNG, Admin, dan Epilog Live Chat
const MEDAL=(c1,c2,rank)=>`<svg class="medal" viewBox="0 0 64 78" aria-label="Medali ${rank}"><path d="M18 4 L30 34 L22 36 L10 6Z" fill="#1CB0F6"/><path d="M46 4 L34 34 L42 36 L54 6Z" fill="#FF4B4B"/><circle cx="32" cy="52" r="22" fill="${c1}" stroke="${c2}" stroke-width="4"/><circle cx="32" cy="52" r="16" fill="none" stroke="#FFF9D6" stroke-width="2" stroke-dasharray="3 3"/><text x="32" y="60" text-anchor="middle" font-family="Nunito,sans-serif" font-weight="900" font-size="22" fill="#fff">${rank}</text></svg>`;
function podiumHTML(list){
  const order=[list[1],list[0],list[2]],cls=['p2','p1','p3'],rk=[2,1,3],mc=[['#B8C2CC','#7D8794'],['#FFD43B','#D99B00'],['#E89B58','#A85A1E']];
  return `<div class="pod">`+order.map((p,i)=>p?`<div class="pcol ${cls[i]}">${MEDAL(mc[i][0],mc[i][1],rk[i])}${AV(p.av,52)}<div class="nm">${esc(p.name)}</div><div class="sc">${p.sc!=null?`Skor ${p.sc}`:''}${p.t!=null?` · ${fmtT(p.t)}`:''}</div><div class="pbase">${rk[i]}</div></div>`:`<div class="pcol ${cls[i]} empty"><div class="sc">Kosong</div><div class="pbase">${rk[i]}</div></div>`).join('')+`</div>`;
}
function crowdHTML(){
  const say=['Barakallah!','Hebat sekali!','Masya Allah!','Keren!','Juara!','Luar biasa!','Mantap!'];
  const pe=shuffle(AVATARS).slice(0,9).map(a=>`${AV(a,46)}`).join('');
  const hr=['❤️','💛','💚','💙'].map((h,i)=>`<span class="hr" style="left:${15+i*22}%;animation-delay:${i*.5}s">${h}</span>`).join('');
  return `<div class="say">“${say[Math.random()*say.length|0]}”</div><div class="cr2">${hr}${pe}</div>`;
}

screens.board=()=>{
  const b=boardGet();let tab='peserta';
  const rows=arr=>arr.map((e,i)=>`<tr class="${i<3?'top':''}${tab!=='regu'&&e.score<0?' low':''}"><td>${i===0?'🥇':i===1?'🥈':i===2?'🥉':i+1}</td><td>${AV(e.av,26)} ${esc(e.name)}</td><td>${tab==='regu'?esc(e.mode||''):e.score}</td>${tab==='regu'?'':`<td>${e.nilai!=null?e.nilai:''}</td><td>${fmtT(e.time)}</td>`}</tr>`).join('')
    ||`<tr><td colspan="5" class="muted center">Belum ada data.</td></tr>`;
  const draw=()=>{
    const arr=b[tab];
    $('#bh').innerHTML=`<th>#</th><th>Nama</th><th>${tab==='regu'?'Keterangan':'Skor'}</th>${tab==='regu'?'':'<th>Nilai</th><th>Waktu</th>'}`;
    $('#bb').innerHTML=rows(arr);
    const fin=tab==='peserta'&&arr.length>=3;
    $('#bext').innerHTML=fin?`<div class="card"><p>3 peringkat teratas siap menghadapi Final Boss!</p><button class="btn coral" data-go="boss">🐲 Tantang Final Boss</button></div>`:'';
  };
  app.innerHTML=`<div class="stack"><h2>🏆 Papan Skor</h2><p class="muted">Skor tertinggi di atas; jika sama, waktu tersingkat yang lebih dulu.</p>
    <div class="tabs" id="bt"><button class="btn ghost sm" data-t="peserta" aria-pressed="true">Peserta</button><button class="btn ghost sm" data-t="umum" aria-pressed="false">Umum</button><button class="btn ghost sm" data-t="regu" aria-pressed="false">Regu &amp; Boss</button></div>
    <div class="card scroll-x"><table class="tbl"><thead><tr id="bh"></tr></thead><tbody id="bb"></tbody></table></div><div id="bext"></div></div>`;
  $('#bt').onclick=e=>{const btn=e.target.closest('[data-t]');if(!btn)return;tab=btn.dataset.t;$$('#bt .btn').forEach(x=>x.setAttribute('aria-pressed',String(x===btn)));draw()};draw();
};

function makeCertPNG(c){
  const W=1200,H=840,cv=document.createElement('canvas');cv.width=W;cv.height=H;const g=cv.getContext('2d');
  const win=c.win!==false;
  g.fillStyle=win?'#FFFDF5':'#F4FBF7';g.fillRect(0,0,W,H);
  g.strokeStyle=win?'#FFC800':'#58CC02';g.lineWidth=18;g.strokeRect(28,28,W-56,H-56);
  g.strokeStyle=win?'#58CC02':'#1CB0F6';g.lineWidth=4;g.strokeRect(48,48,W-96,H-96);
  g.fillStyle=win?'#58A700':'#1899D6';g.textAlign='center';g.font='900 22px Nunito,sans-serif';
  g.fillText("TPA AL-MUNAWWARAH PRAMUKA · CERDAS CERMAT GENERASI QUR'ANI",W/2,125);
  g.fillStyle='#2B2B2B';g.font='900 54px Nunito,sans-serif';
  g.fillText(win?'SERTIFIKAT PENGHARGAAN':'SERTIFIKAT SEMANGAT BELAJAR',W/2,195);
  g.fillStyle='#666';g.font='700 24px Nunito,sans-serif';g.fillText('Diberikan dengan bangga kepada',W/2,260);
  g.fillStyle='#2B2B2B';g.font='900 62px Nunito,sans-serif';g.fillText(c.name,W/2,338);
  g.fillStyle=win?'#46A302':'#1480B5';g.font='900 34px Nunito,sans-serif';g.fillText(c.title,W/2,396);
  g.fillStyle='#555';g.font='700 24px Nunito,sans-serif';g.fillText(c.sub||'',W/2,440);
  const st=[];if(c.score!=null)st.push('Skor: '+c.score+(c.max?' / '+c.max:''));if(c.nilai!=null)st.push('Nilai: '+c.nilai);if(c.time)st.push('Waktu: '+fmtT(c.time));
  if(st.length){g.fillStyle='#2B2B2B';g.font='800 26px Nunito,sans-serif';g.fillText(st.join('   ·   '),W/2,510)}
  g.fillStyle='#444';g.font='700 22px Nunito,sans-serif';
  const msg=win?"Semoga ilmu Qur'ani yang diraih menjadi cahaya kebaikan dan bekal akhlak mulia setiap hari.":"Setiap langkah belajar adalah kebaikan. Terus berlatih dengan gembira, kamu pasti bisa!";
  g.fillText(msg,W/2,580);
  g.fillStyle='#666';g.font='700 20px Nunito,sans-serif';
  g.fillText(new Date().toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'}),270,710);
  g.fillText('Ustadz Farhan',W-270,710);
  g.strokeStyle='#bbb';g.lineWidth=2;g.beginPath();g.moveTo(W-390,682);g.lineTo(W-150,682);g.stroke();
  return cv.toDataURL('image/png');
}
screens.cert=()=>{
  const c=S.cert;if(!c){toast('Selesaikan permainan dulu untuk mendapat sertifikat');return go('hub')}
  const url=makeCertPNG(c);
  app.innerHTML=`<div class="stack center"><h2>🎓 Sertifikat</h2><p class="muted">Simpan gambarmu sebagai kenang-kenangan.</p>
    <img class="cert-img" src="${url}" alt="Sertifikat untuk ${esc(c.name)}">
    <div class="row" style="justify-content:center"><a class="btn sun" download="sertifikat-${c.name.toLowerCase().replace(/\s+/g,'-')}.png" href="${url}">⬇️ Unduh PNG</a><button class="btn ghost" data-go="hub">Menu</button></div></div>`;
};

screens.admin=()=>{
  if(!S.admin){
    app.innerHTML=`<div class="stack"><h2>🔧 Admin</h2><div class="card pop"><p class="muted">Masukkan kata sandi pengajar.</p>
      <form id="af" class="stack"><div><label for="ap">Kata sandi</label><input type="password" id="ap" autocomplete="off"></div><div class="err" id="ae" role="alert"></div>
      <button class="btn" type="submit">Masuk</button></form></div></div>`;
    $('#af').onsubmit=e=>{e.preventDefault();if($('#ap').value===TEACHER_PW){S.admin=true;screens.admin()}else{$('#ae').textContent='Kata sandi belum tepat.'}};
    return;
  }
  const L=getLocks();
  const items=[['all','Buka semua kunci'],['t4','Musik Track 4'],['t5','Musik Track 5'],['boss','Final Boss: Iblis'],['epilog','Halaman Epilog']];
  const syncLockUI=()=>{
    const curL=getLocks();
    $$('[data-lock-key]').forEach(btn=>{
      const k=btn.dataset.lockKey;
      const isOn=!!(curL.all||curL[k]);
      btn.setAttribute('aria-checked',String(isOn));
      const lbl=btn.querySelector('.lock-st');
      if(lbl)lbl.textContent=isOn?'Terbuka':'Terkunci';
    });
  };
  app.innerHTML=`<div class="stack"><h2>🔧 Panel Admin</h2>
    <div class="card stack"><h3>Musik &amp; volume</h3>${musicControlsHTML('vol3')}</div>
    <div class="card stack"><h3>Kunci konten</h3>
      ${items.map(([k,n])=>{const on=!!(L.all||L[k]);return `<div class="lockRow"><span>${n}</span><button type="button" class="lockSw" role="switch" aria-checked="${on}" aria-label="${n}" data-lock-key="${k}"><span class="lock-st">${on?'Terbuka':'Terkunci'}</span><span class="sw"></span></button></div>`}).join('')}
    </div>
    <div class="card stack"><h3>Hapus data</h3><p class="muted small">Jika ada peserta yang keluar sebelum selesai dan bundle/papan skor perlu dirapikan.</p>
      <div class="row"><button class="btn ghost sm" id="rb">Buka ulang bundle terpilih</button><button class="btn coral sm" id="cb">Kosongkan papan skor</button><button class="btn coral sm" id="ca">Reset semua data</button></div><div class="err" id="am"></div></div></div>`;
  renderDock();
  $$('[data-lock-key]').forEach(btn=>{
    btn.onclick=()=>{
      const k=btn.dataset.lockKey;
      const nextState=btn.getAttribute('aria-checked')!=='true';
      setLockState(k,nextState);
      syncLockUI();
      toast((nextState?'Dibuka: ':'Dikunci: ')+btn.getAttribute('aria-label'));
    };
  });
  $('#rb').onclick=()=>{resetUsedBundles();$('#am').textContent='Semua bundle terpilih sudah dibuka kembali.'};
  $('#cb').onclick=()=>{store.set('board',{peserta:[],umum:[],regu:[]});$('#am').textContent='Papan skor dikosongkan.'};
  $('#ca').onclick=()=>{store.set('board',{peserta:[],umum:[],regu:[]});store.set('locks',{});resetUsedBundles();syncLockUI();$('#am').textContent='Semua data direset.'};
};

const DEFAULT_CHAT=[
  {id:'init-1',name:'Ustadz Farhan',role:'Penggagas',msg:'Selamat datang di halaman Epilog! Silakan tulis kritik, saran, atau doa untuk pengembangan Cerdas Cermat Generasi Qur\'ani.',at:Date.now()-3600000},
  {id:'init-2',name:'TPA Al-Munawwarah',role:'Pramuka',msg:'Semoga kegiatan belajar sambil bermain ini bermanfaat dan menumbuhkan cinta Al-Qur\'an pada generasi muda.',at:Date.now()-1800000}
];
function getChatList(){
  const saved=store.get('epilog_chat',null);
  if(Array.isArray(saved))return saved;
  store.set('epilog_chat',DEFAULT_CHAT);
  return DEFAULT_CHAT.slice();
}
function saveChatList(list){store.set('epilog_chat',list)}

screens.epilog=()=>{
  if(!isOpen('epilog')){toast('Epilog masih terkunci 🔒');return go('hub')}
  Music.auto(5);
  let adminUnlocked=false;
  const renderFeed=()=>{
    const list=getChatList();
    const el=$('#chat-feed');
    if(!el)return;
    el.innerHTML=list.length?list.map(item=>`<div class="chat-item" data-id="${esc(item.id)}">
      <div class="chat-meta">
        <span class="chat-author">💬 ${esc(item.name||'Sahabat Qur\'ani')}${item.role?` <span class="tag">${esc(item.role)}</span>`:''}</span>
        <span class="chat-time">${esc(fmtTimeAgo(item.at))}</span>
      </div>
      <div class="chat-msg">${esc(item.msg)}</div>
      ${adminUnlocked?`<div class="row" style="margin-top:4px"><button type="button" class="btn coral sm" data-del="${esc(item.id)}">🗑️ Hapus</button></div>`:''}
    </div>`).join(''):'<p class="muted center">Belum ada pesan kritik atau saran. Jadilah yang pertama mengirim pesan!</p>';
  };

  app.innerHTML=`<div class="stack">
    <div class="card pop slide center">
      <div class="big">💌</div>
      <h2>Terima kasih, sahabat Qur'ani!</h2>
      <p style="max-width:52ch">Jazaakumullahu khairan katsira atas semangat belajar, kejujuran, dan kebersamaan hari ini. Semoga setiap ayat, kisah nabi, dan ilmu yang dipelajari menjadi cahaya kebaikan dalam kehidupan sehari-hari.</p>
    </div>

    <div class="grid">
      <div class="card pop">
        <span class="tag">Penggagas &amp; Pengembang</span>
        <h3 style="margin-top:8px">Ustadz Farhan</h3>
        <p class="muted small" style="margin-top:6px">Menyusun soal, alur permainan, ilustrasi, dan sistem interaktif Cerdas Cermat: Generasi Qur'ani.</p>
      </div>
      <div class="card pop">
        <span class="tag">Mitra Pembinaan</span>
        <h3 style="margin-top:8px">TPA Al-Munawwarah Pramuka</h3>
        <p class="muted small" style="margin-top:6px">Wadah pembinaan generasi Qur'ani yang berakhlak mulia, tangguh, dan berjiwa kepramukaan.</p>
      </div>
    </div>

    <div class="card pop stack">
      <div class="live-chat-head">
        <div>
          <h3>💬 Live Chat Kritik &amp; Saran</h3>
          <p class="muted small" style="margin:2px 0 0">Pesan tampil langsung di papan publik dan tersimpan di perangkat ini.</p>
        </div>
        <span class="live-badge"><span class="live-dot"></span>Publik · Live</span>
      </div>

      <form id="cf" class="stack">
        <div>
          <label for="cn">Nama pengirim (opsional)</label>
          <input type="text" id="cn" maxlength="24" placeholder="contoh: Fatih / Peserta TPA" autocomplete="off">
        </div>
        <div>
          <label for="cm">Kritik, saran, atau pesan</label>
          <textarea id="cm" maxlength="400" placeholder="Tulis kritik, saran, atau kesan bermain di sini..."></textarea>
        </div>
        <div class="err" id="ce" role="alert"></div>
        <button class="btn lg" type="submit">📤 Kirim ke Live Chat</button>
      </form>

      <div class="chat-feed" id="chat-feed" aria-live="polite"></div>

      <div class="card" style="background:var(--surface2)">
        <div class="row" style="justify-content:space-between">
          <b>Kelola pesan (Admin)</b>
          <span class="small muted" id="adm-status">${adminUnlocked?'Mode Admin aktif':'Terkunci'}</span>
        </div>
        <div id="adm-gate" class="row" style="margin-top:10px">
          <input type="password" id="ep-pw" placeholder="Kata sandi pengajar" autocomplete="off" style="flex:1;min-width:160px">
          <button type="button" class="btn ghost sm" id="ep-unlock">🔓 Buka Kelola</button>
        </div>
        <div id="adm-tools" class="row hide" style="margin-top:10px">
          <button type="button" class="btn sun sm" id="ep-dl">⬇️ Unduh JSON</button>
          <button type="button" class="btn coral sm" id="ep-clear">🧹 Hapus Semua</button>
          <button type="button" class="btn ghost sm" id="ep-lock">🔒 Kunci Lagi</button>
        </div>
      </div>
    </div>

    <div class="row" style="justify-content:center">
      <button class="btn" data-go="hub">🏠 Kembali ke Menu</button>
      <button class="btn ghost" data-go="board">🏆 Papan Skor</button>
    </div>
  </div>`;

  renderFeed();

  $('#cf').onsubmit=e=>{
    e.preventDefault();
    const rawMsg=$('#cm').value.trim();
    if(!rawMsg){$('#ce').textContent='Tulis kritik atau saran terlebih dahulu ya.';return}
    $('#ce').textContent='';
    const sender=cleanName($('#cn').value,24)||'Sahabat Qur\'ani';
    const list=getChatList();
    list.unshift({
      id:'msg-'+Date.now()+'-'+Math.random().toString(36).slice(2,6),
      name:sender,
      role:'',
      msg:rawMsg,
      at:Date.now()
    });
    saveChatList(list);
    $('#cm').value='';
    renderFeed();
    Music.sfx('card');
    toast('Pesan terkirim ke Live Chat 💬');
  };

  $('#ep-unlock').onclick=()=>{
    if($('#ep-pw').value===TEACHER_PW){
      adminUnlocked=true;
      $('#ep-pw').value='';
      $('#adm-status').textContent='Mode Admin aktif';
      $('#adm-gate').classList.add('hide');
      $('#adm-tools').classList.remove('hide');
      renderFeed();
      toast('Mode kelola pesan Admin terbuka');
    }else{
      toast('Kata sandi pengajar belum tepat');
    }
  };

  $('#ep-lock').onclick=()=>{
    adminUnlocked=false;
    $('#adm-status').textContent='Terkunci';
    $('#adm-gate').classList.remove('hide');
    $('#adm-tools').classList.add('hide');
    renderFeed();
  };

  $('#ep-dl').onclick=()=>{
    const dataStr='data:text/json;charset=utf-8,'+encodeURIComponent(JSON.stringify(getChatList(),null,2));
    const a=document.createElement('a');
    a.href=dataStr;
    a.download='kritik-saran-cerdas-cermat.json';
    document.body.appendChild(a);
    a.click();
    a.remove();
    toast('File kritik & saran diunduh');
  };

  $('#ep-clear').onclick=()=>{
    saveChatList([]);
    renderFeed();
    toast('Semua pesan kritik & saran dihapus');
  };

  $('#chat-feed').onclick=e=>{
    const delBtn=e.target.closest('[data-del]');
    if(!delBtn||!adminUnlocked)return;
    const id=delBtn.dataset.del;
    const next=getChatList().filter(item=>item.id!==id);
    saveChatList(next);
    renderFeed();
    toast('Pesan dihapus');
  };
};

matchMedia('(prefers-color-scheme:dark)').addEventListener('change',syncTheme);
syncNavLocks();
go('gate');
</script>
