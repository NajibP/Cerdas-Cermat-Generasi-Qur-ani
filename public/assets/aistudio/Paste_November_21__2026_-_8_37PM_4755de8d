function setupScreen(cat){
  const peserta=cat==='peserta';
  app.innerHTML=`<div class="stack"><h2>${peserta?'🦖 Peserta':'🌟 Umum'}</h2><div class="card pop stack">
    <div><label>Pilih avatar</label>${avPicker()}</div>
    <div><label for="nm">Nama (maksimal 10 huruf)</label><input type="text" id="nm" maxlength="10" placeholder="contoh: Farhan" autocomplete="off"></div>
    <div class="err" id="ne" role="alert"></div><button class="btn lg" id="go">Lanjut pilih bundle →</button></div></div>`;
  bindAv();
  $('#go').onclick=()=>{const n=cleanName($('#nm').value);if(!n){$('#ne').textContent='Isi namamu dulu ya.';return}
    S.sess={kind:cat,name:n,av:$('#avs').dataset.v,done:[],score:0,correct:0,total:0,time:0,streak:0,frenzy:0,minStreak:0};
    peserta?go('pes-list'):(S.lockedIn=false,go('umum-list'))};
}
screens['cat-peserta']=()=>setupScreen('peserta');
screens['cat-umum']=()=>setupScreen('umum');

