    <div class="grid">${UMUM_B.map((b,i)=>{const d=se.done.includes(i)||isBundleUsed('umum',i);return `<button class="card pop mode ${d?'locked':''}" data-b="${i}" ${d?'disabled':''}><span class="ic">${d?'🔒':b[0]}</span><span><h3>${b[1]}</h3><span class="tag ${b[2]}">${TIER_L[b[2]]}</span> <span class="tag">${d?'terkunci 🔒':'10 soal'}</span></span></button>`}).join('')}</div>
