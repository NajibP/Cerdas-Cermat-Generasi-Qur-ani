    <div class="row" style="justify-content:center"><span class="pill">Skor ${se.score}</span><span class="pill">Nilai ${nilai}</span><span class="pill">Waktu ${fmtT(se.time)}</span></div>
    <p class="small muted">${rec.kept?`Tercatat di papan skor, peringkat ${rec.rank}.`:'Papan skor sudah penuh 10 nama dan skormu belum menembusnya.'}${cnt>=3?' Final Boss sudah terbuka untuk 3 peringkat teratas.':''}</p></div>
    <div class="row" style="justify-content:center"><button class="btn sun" data-go="cert">🎓 Sertifikat</button><button class="btn" data-go="board">🏆 Papan skor</button><button class="btn ghost" data-go="hub">Menu</button></div></div>`;
