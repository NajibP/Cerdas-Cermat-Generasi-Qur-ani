    4:{n:'Ultimate Pace',bpm:168,root:50,sc:[0,3,5,6,7,10],ch:[[0,3,7],[-4,0,3],[-2,2,5],[-5,-1,4]],lead:'sawtooth',bass:'square',drums:3,div:4,g:.06},
    5:{n:'End Pace',bpm:76,root:67,sc:[0,2,4,7,9],ch:[[0,4,7],[7,11,14],[-3,0,4],[-7,-3,0]],lead:'sine',bass:'sine',drums:0,div:2,g:.2}
  };
  function init(){
    if(ctx) return true;
    try{
      const AC=window.AudioContext||window.webkitAudioContext; if(!AC) return false;
      ctx=new AC();
      master=ctx.createGain(); master.gain.value=vol; master.connect(ctx.destination);
      sfxBus=ctx.createGain(); sfxBus.gain.value=vol; sfxBus.connect(ctx.destination);
      noiseBuf=ctx.createBuffer(1,ctx.sampleRate*.5,ctx.sampleRate);
      const d=noiseBuf.getChannelData(0); for(let i=0;i<d.length;i++) d[i]=Math.random()*2-1;
      return true;
    }catch(e){return false}
  }
  function tone(f,t,dur,type,g,dest){
    const o=ctx.createOscillator(),a=ctx.createGain();
    o.type=type;o.frequency.value=f;
    a.gain.setValueAtTime(0,t);a.gain.linearRampToValueAtTime(g,t+.012);a.gain.exponentialRampToValueAtTime(.0001,t+dur);
    o.connect(a);a.connect(dest||master);o.start(t);o.stop(t+dur+.06);
  }
  function noise(t,dur,g,hp,dest){
    const s=ctx.createBufferSource(),a=ctx.createGain(),f=ctx.createBiquadFilter();
    s.buffer=noiseBuf;f.type='highpass';f.frequency.value=hp;
    a.gain.setValueAtTime(g,t);a.gain.exponentialRampToValueAtTime(.0001,t+dur);
    s.connect(f);f.connect(a);a.connect(dest||master);s.start(t);s.stop(t+dur+.02);
  }
  function kick(t,dest){const o=ctx.createOscillator(),a=ctx.createGain();o.frequency.setValueAtTime(140,t);o.frequency.exponentialRampToValueAtTime(40,t+.15);
    a.gain.setValueAtTime(.5,t);a.gain.exponentialRampToValueAtTime(.001,t+.2);o.connect(a);a.connect(dest||master);o.start(t);o.stop(t+.25)}
  function schedule(tr,s,t,dur,bus){
    const per=tr.div*4, bar=Math.floor(s/per)%tr.ch.length, pos=s%per, ch=tr.ch[bar];
    const beat=pos/tr.div;
    if(pos%2===0) tone(N(tr.root+ch[0]-12),t,dur*(tr.div===4?1.6:3),tr.bass,tr.g*1.8,bus);
    const idx=(pos+bar*3)%ch.length;
    let note=tr.root+ch[idx]+12;
    if((s>>1)%5===3||pos%6===5) note=tr.root+12+tr.sc[(pos*2+bar)%tr.sc.length]+12;
    if(!(tr.drums===0&&pos%2===1&&Math.random()<.3)) tone(N(note),t,dur*(tr.div===4?1.2:2.2),tr.lead,tr.g,bus);
    if(tr.lead==='sine'&&pos===0) tone(N(tr.root+ch[2]+24),t,dur*6,'sine',tr.g*.7,bus);
    if(tr.drums>=1){
      if(pos%tr.div===0&&(beat%2===0||tr.drums>=2)) kick(t,bus);
      if(beat%2===1&&pos%tr.div===0) noise(t,.12,.18,1800,bus);
      if(tr.drums>=2&&pos%2===1) noise(t,.04,.06,7000,bus);
      if(tr.drums===3&&pos%4===2) noise(t,.05,.1,5000,bus);
    }
  }
  function fadeOut(inst,fade=1.4){
    if(!inst)return;
    clearInterval(inst.timer);
    if(ctx&&inst.bus){
      const now=ctx.currentTime;
      try{
        inst.bus.gain.cancelScheduledValues(now);
        inst.bus.gain.setValueAtTime(Math.max(.0001,inst.bus.gain.value),now);
        inst.bus.gain.exponentialRampToValueAtTime(.0001,now+fade);
      }catch(e){}
      setTimeout(()=>{try{inst.bus.disconnect()}catch(e){}},(fade+.3)*1000);
    }
  }
  function play(n,fade=0){
    if(!T[n]||!init()) return;
    if(ctx.state==='suspended') ctx.resume().catch(()=>{});
    fadeOut(active,fade>0?fade:.15);
    const bus=ctx.createGain();
    const now=ctx.currentTime;
    if(fade>0){
      bus.gain.setValueAtTime(.0001,now);
      bus.gain.exponentialRampToValueAtTime(1,now+fade);
    }else{
      bus.gain.setValueAtTime(1,now);
    }
    bus.connect(master);
    const inst={n,tr:T[n],step:0,nextT:now+.06,bus,timer:null};
    const tick=()=>{
      if(!ctx)return;
      if(ctx.state==='suspended'){ctx.resume().catch(()=>{});inst.nextT=ctx.currentTime+.06;return}
      const dur=60/inst.tr.bpm/inst.tr.div;
      while(inst.nextT<ctx.currentTime+.25){schedule(inst.tr,inst.step,inst.nextT,dur,inst.bus);inst.nextT+=dur;inst.step++}
    };
    inst.timer=setInterval(tick,55);
    tick();
    active=inst;cur=n;started=true;muted=false;
    renderDock();
  }
  const api={
    T,
    get cur(){return cur}, get playing(){return !!active}, get muted(){return muted},
    play(n){play(n,.35)},
    pause(){fadeOut(active,.35);active=null;muted=true;renderDock()},
    toggle(){if(active){api.pause()}else{play(cur||1,.35)}},
    auto(n){
      if(active&&cur===n){renderDock();return}
      const prev=cur;
      cur=n;
      if(!muted||!started) play(n,prev&&prev!==n?1.6:.4);
      else renderDock();
    },
    setVol(v){vol=v;if(master)master.gain.value=v;if(sfxBus)sfxBus.gain.value=v},
    get vol(){return vol},
    sfx(kind){
      if(!init()||(muted&&started)) return; if(ctx.state==='suspended') ctx.resume().catch(()=>{});
      const t=ctx.currentTime;
      if(kind==='ok'){tone(N(79),t,.18,'triangle',.25,sfxBus);tone(N(84),t+.1,.3,'triangle',.25,sfxBus)}
      else if(kind==='no'){tone(N(52),t,.3,'sawtooth',.18,sfxBus);tone(N(49),t+.12,.35,'sawtooth',.18,sfxBus)}
      else if(kind==='bell'){tone(N(88),t,.8,'sine',.3,sfxBus);tone(N(95),t,.8,'sine',.18,sfxBus)}
      else if(kind==='hit'){noise(t,.2,.4,300,sfxBus);kick(t,sfxBus)}
      else if(kind==='roar'){tone(N(36),t,.6,'sawtooth',.25,sfxBus);tone(N(35),t,.6,'square',.12,sfxBus)}
      else if(kind==='win'){[72,76,79,84,88].forEach((m,i)=>tone(N(m),t+i*.12,.4,'triangle',.25,sfxBus))}
      else if(kind==='card'){tone(N(81),t,.15,'sine',.25,sfxBus);tone(N(93),t+.08,.25,'sine',.2,sfxBus)}
      else if(kind==='cheer'){for(let i=0;i<16;i++)noise(t+i*.1,.3,.1,500+(i%4)*300,sfxBus);[67,72,76,79].forEach((m,i)=>tone(N(m),t+i*.1,.5,'triangle',.12,sfxBus))}
      else if(kind==='tick'){tone(N(96),t,.05,'square',.06,sfxBus)}
    }
  };
  return api;
})();
