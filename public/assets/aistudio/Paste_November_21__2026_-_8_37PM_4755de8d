    <div class="grid">${['A','B'].map(k=>`<div class="card stack"><h3>Regu ${k}</h3><div><label for="n${k}">Nama regu (maks. 12)</label><input type="text" id="n${k}" maxlength="12" autocomplete="off"></div><div><label>Avatar</label>${avPicker('av'+k)}</div></div>`).join('')}</div>
    <div class="err" id="er" role="alert"></div><button class="btn lg" id="st">Mulai duel ⚔️</button></div>`;
  bindAv('avA');bindAv('avB');
  $('#avB').querySelectorAll('.av').forEach((b,i)=>b.setAttribute('aria-pressed',String(i===1)));$('#avB').dataset.v=AVATARS[1];
