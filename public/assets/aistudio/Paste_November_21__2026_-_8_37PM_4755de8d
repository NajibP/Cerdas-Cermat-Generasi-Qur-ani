    runRegu(+$('#sz').value,[{name:a,av:$('#avA').dataset.v,score:0},{name:b,av:$('#avB').dataset.v,score:0}])};
};
async function runRegu(size,T){
  const run=++S.gameRun;
  let curAsk=null;
  setInGame(true,()=>{if(curAsk)curAsk.stop()});
  const hudHTML=()=>`<div class="hud"><span class="pill">${AV(T[0].av,26)} ${esc(T[0].name)} · <b class="tnum">${T[0].score}</b></span><span class="pill">VS</span><span class="pill">${AV(T[1].av,26)} ${esc(T[1].name)} · <b class="tnum">${T[1].score}</b></span><button class="btn coral sm" id="exit-game">🚪 Keluar</button></div>`;
  const syncHud=()=>{
    if(!isRunValid(run))return;
    $$('.hud').forEach(h=>{h.outerHTML=hudHTML()});
  };
  const frame=(banner,extra='')=>{app.innerHTML=`<div class="stack">${hudHTML()}<div class="card"><span class="tag">${banner}</span></div>${extra}<div class="card" id="qh"></div></div>`;return $('#qh')};
  const fb=(k,m)=>$('#qh').insertAdjacentHTML('beforeend',`<div class="fb ${k}" style="margin-top:12px">${m}</div><div style="margin-top:12px"><button class="btn" id="nx">Lanjut →</button></div>`);

  Music.auto(2);
  for(let ti=0;ti<2;ti++){
    const qs=pick({mudah:3}).map(prep);
    for(let k=0;k<3;k++){
      if(!isRunValid(run))return;
      const host=frame(`Babak 1 · Starter Point · soal ${k+1}/3`);
      host.innerHTML=`<p><b>${AV(T[ti].av,26)} ${esc(T[ti].name)}</b>, penjawab: <b>Anggota ${(k%size)+1}</b>. ⏱ 30 detik. Benar +50, salah 0.</p><button class="btn lg" id="go">Mulai soal</button>`;
      await waitFor('#go',run);if(!isRunValid(run))return;
      curAsk=ask(host,qs[k],{seconds:30});
      const r=await curAsk.promise;if(!isRunValid(run))return;
      if(r.status==='correct'){T[ti].score+=50;Music.sfx('ok');fb('ok','Benar! +50')}else{Music.sfx('no');fb('no',r.status==='wrong'?'Belum tepat. 0 poin':'Waktu habis. 0 poin')}
      syncHud();await waitFor('#nx',run);if(!isRunValid(run))return;
    }
  }
  async function rebutan(q,secs,label,scored=true){
    if(!isRunValid(run))return -1;
    const host=frame(label,`<div class="row" id="bl"><button class="btn sun bell" id="b0">🔔<br>${esc(T[0].name)}<br><small>tombol A</small></button><button class="btn violet bell" id="b1">🔔<br>${esc(T[1].name)}<br><small>tombol L</small></button></div><div class="row"><button class="btn ghost sm" id="sk">Lewati soal</button></div>`);
    host.innerHTML=`<p class="muted small">Baca soalnya, lalu tekan lonceng regumu paling cepat!</p><div class="qtext">${esc(q.q)}</div>`;
    const who=await new Promise(res=>{
      const done=val=>{window.onkeydown=null;res(val)};
      $('#b0').onclick=()=>done(0);$('#b1').onclick=()=>done(1);$('#sk').onclick=()=>done(-1);
      window.onkeydown=e=>{const k=e.key.toLowerCase();if(k==='a')done(0);if(k==='l')done(1)};
    });
    if(!isRunValid(run))return -1;
    if(who<0){fb('no','Soal dilewati');await waitFor('#nx',run);return -1}
    Music.sfx('bell');$('#bl').innerHTML=`<div class="pill hot">🔔 ${esc(T[who].name)} menekan lonceng!</div>`;$('#sk')?.remove?.();
    let order=[who,1-who],winner=-1;
    for(let i=0;i<2&&winner<0;i++){
      if(!isRunValid(run))return -1;
      const tm=order[i];
      $('#qh').innerHTML='';const hh=$('#qh');
      const lead=document.createElement('p');lead.innerHTML=`Giliran <b>${AV(T[tm].av,26)} ${esc(T[tm].name)}</b> menjawab${i?' (lemparan)':''}. ⏱ ${secs} detik.`;hh.appendChild(lead);
      const box=document.createElement('div');hh.appendChild(box);
      curAsk=ask(box,q,{seconds:secs});
      const r=await curAsk.promise;if(!isRunValid(run))return -1;
      if(r.status==='correct'){if(scored)T[tm].score+=100;winner=tm;Music.sfx('ok');box.insertAdjacentHTML('beforeend',`<div class="fb ok" style="margin-top:12px">${esc(T[tm].name)} benar!${scored?' +100':''}</div>`)}
      else{if(scored)T[tm].score-=50;Music.sfx('no');box.insertAdjacentHTML('beforeend',`<div class="fb no" style="margin-top:12px">${esc(T[tm].name)} ${r.status==='wrong'?'belum tepat':'kehabisan waktu'}${scored?'. −50':''}${i===0?'. Soal dilempar ke regu lawan!':''}</div>`)}
      syncHud();
      if(i===0&&winner<0){await sleep(1800);if(!isRunValid(run))return -1}
    }
    $('#qh').insertAdjacentHTML('beforeend',`<div style="margin-top:12px"><button class="btn" id="nx">Lanjut →</button></div>`);
    await waitFor('#nx',run);return winner;
  }
  Music.auto(3);
  for(const [k,q] of pick({mudah:5}).map(prep).entries()){await rebutan(q,20,`Babak 2 · Rebutan · soal ${k+1}/5`);if(!isRunValid(run))return}
  unlock('t4');Music.auto(4);
  for(const [k,q] of pick({mudah:2,sedang:3}).map(prep).entries()){await rebutan(q,15,`Babak 3 · Final · soal ${k+1}/5`);if(!isRunValid(run))return}
  let sd=0,win=-1;
  if(T[0].score===T[1].score){
    toast('Skor seri! Sudden Death dimulai ⚡');
    while(win<0){sd++;win=await rebutan(prep(pick({sedang:1})[0]),15,`Sudden Death · soal ${sd}`,false);if(!isRunValid(run))return}
  }else win=T[0].score>T[1].score?0:1;
  Music.auto(5);afterFinish();Music.sfx('win');confetti(['🏆','🎉','⭐','🛡️']);setTimeout(()=>Music.sfx('cheer'),1500);
  const W=T[win],Lz=T[1-win];
  boardAdd('regu',{name:W.name,av:W.av,score:W.score,mode:`Regu Duel ${size}v${size}`});
  S.cert={name:W.name,av:W.av,score:W.score,nilai:null,time:0,title:'Juara Regu Duel',sub:`Regu Duel ${size} vs ${size} · mengalahkan ${Lz.name}`,win:true};
  app.innerHTML=`<div class="stack center"><div class="card pop slide"><div class="big">🏆</div><h2>${AV(W.av,26)} ${esc(W.name)} juara!</h2>
    <p style="max-width:52ch">Selamat! ${sd?'Kemenangan diraih lewat Sudden Death yang menegangkan.':'Kerja sama regu yang kompak dan cermat.'} ${esc(Lz.name)} juga hebat, terus semangat belajar!</p>
    ${podiumHTML([{name:W.name,av:W.av,sc:W.score},{name:Lz.name,av:Lz.av,sc:Lz.score}])}${crowdHTML()}</div>
    <div class="row" style="justify-content:center"><button class="btn sun" data-go="cert">🎓 Sertifikat</button><button class="btn" data-go="board">🏆 Papan skor</button><button class="btn ghost" data-go="hub">Menu</button></div></div>`;
}

const KELAS=['TKA','TPA','Tadarrus'];
