// Mesin permainan bundle dengan Kartu Hikmah dan Istiqomah Frenzy
function runBundle(def){
  const run=++S.gameRun;
  const se=S.sess,peserta=se.kind==='peserta',qs=pick(def.spec).map(prep),n=qs.length,st=Array(n).fill(null);
  let cards={},shield=false,h=null,busy=false,hits=0,miss=0,answered=0,wr=0,ults=0,koDone=false;
  setInGame(true,()=>{if(h)h.stop()});
  Music.auto(def.t);
  const hpK=()=>Math.max(0,100-hits*10),hpH=()=>Math.max(0,100-miss*10-ults*25);
  app.innerHTML=`<div class="stack">
    <div class="hud"><span class="pill">${AV(se.av,26)} ${esc(se.name)}</span><span class="pill tnum">⭐ <span id="sc">${se.score}</span></span><span class="pill" id="stk">🔥 ${se.streak}</span><span class="pill hot hide" id="frz">⚡ Istiqomah Frenzy</span><button class="btn coral sm" id="exit-game">🚪 Keluar</button></div>
    ${peserta?stageHTML({av:se.av,hname:se.name,kname:SYV[se.cur].n,v:se.cur,hpH:100,hpK:100}):''}
    <div class="muted small">${esc(def.label)} · pilih nomor soal. Soal yang dipilih tetap sinkron dengan kunci jawabannya.</div>
    <div class="tiles" id="tl">${qs.map((_,i)=>`<button class="tile" data-i="${i}">${i+1}</button>`).join('')}</div>
    <div class="card" id="qh"><p class="muted center">Pilih satu nomor soal untuk mulai ⏱ 60 detik.</p></div>
    <div class="cards" id="ck"></div></div>`;
  const kb={tameng:['🛡️ Tameng Dosa','Salah = 0 poin hilang'],cahaya:['💡 Cahaya Iman','Sisakan 2 pilihan'],sabar:['🍇 Buah Sabar','+15 detik']};
  const drawCards=()=>{$('#ck').innerHTML=Object.entries(kb).map(([k,v])=>`<button class="hk ${shield&&k==='tameng'?'armed':''}" data-k="${k}" ${(!busy||cards[k]||koDone)?'disabled':''}>${v[0]}<small>${cards[k]?'sudah dipakai':v[1]}</small></button>`).join('')};
  const hud=()=>{$('#sc').textContent=se.score;$('#stk').textContent='🔥 '+se.streak;$('#frz').classList.toggle('hide',!(se.frenzy>0));
    if(peserta){$('#hh').style.width=hpH()+'%';$('#hk').style.width=hpK()+'%'}};
  const fl=(t)=>{const s=$('#stg');if(!s)return;const f=document.createElement('div');f.className='float';f.textContent=t;s.appendChild(f);setTimeout(()=>f.remove(),1000)};
  drawCards();
  $('#ck').onclick=e=>{const b=e.target.closest('.hk');if(!b||b.disabled||!busy||koDone)return;const k=b.dataset.k;cards[k]=true;Music.sfx('card');
    if(k==='tameng'){shield=true;toast('Tameng Dosa siap menahan serangan 🛡️')}
    if(k==='cahaya'&&h)h.eliminate();
    if(k==='sabar'&&h)h.addTime(15);drawCards()};
  $('#tl').onclick=async e=>{
    if(koDone)return;
    const t=e.target.closest('.tile');if(!t||busy||t.disabled)return;
    const i=+t.dataset.i;if(isNaN(i)||i<0||i>=n||st[i]!==null)return;
    busy=true;shield=false;$$('.tile').forEach(x=>x.disabled=true);t.classList.add('on');drawCards();
    const activeIds=new Set(qs.map((q,idx)=>idx===i||st[idx]!==null?q.id:null).filter(Boolean));
    const remIdx=st.map((v,idx)=>v===null&&idx!==i?idx:-1).filter(idx=>idx>=0);
    if(remIdx.length>0){
      const freshPool=pick(def.spec,S.used,activeIds).map(prep);
      remIdx.forEach((idx,k)=>{if(freshPool[k]){qs[idx]=freshPool[k];S.used.add(freshPool[k].id);activeIds.add(freshPool[k].id)}});
    }
    const frenzy=se.frenzy>0;h=ask($('#qh'),qs[i],{seconds:60,rate:frenzy?.5:1});
    const r=await h.promise;if(!isRunValid(run))return;busy=false;if(frenzy)se.frenzy--;
    let pts=0,msg;
    if(r.status==='correct'){pts=100;se.correct++;hits++;wr=0;se.streak++;Music.sfx('ok');msg=['ok','Benar! +100 🎉'];
      if(peserta&&!isHeroKO()){if(hits===10)ultHero();else fxHero();fl('−1 syaitan!')}
      if(se.streak%3===0){se.frenzy=3;toast('⚡ Istiqomah Frenzy! 3 soal berikutnya waktu berjalan pelan');Music.sfx('card')}
      if(se.streak%5===0){cards={};toast('✨ Kartu Hikmah terisi lagi!')}}
    else{se.streak=0;miss++;wr++;
      if(r.status==='wrong'){pts=shield?0:-50;msg=['no',shield?'Salah, tapi Tameng Dosa menahan serangan! 0 poin':'Belum tepat. −50']}
      else{pts=-100;msg=['no','Waktu habis. −100']}
      Music.sfx('no');if(peserta){if(wr>=5){wr=0;ults++;ultEnemy(se.cur);fl('Ultimate!')}else if(!shield){fxKaiju(se.cur);fl('Aduh!')}}}
    se.score+=pts;se.time+=r.elapsed;se.total++;answered++;st[i]=r.status;
    t.className='tile '+(r.status==='correct'?'ok':r.status==='wrong'?'no':'to');t.textContent=r.status==='correct'?'✓':r.status==='wrong'?'✗':'⏱';
    $('#qh').insertAdjacentHTML('beforeend',`<div class="fb ${msg[0]}" style="margin-top:12px">${msg[1]}</div>`);
    hud();

    if(peserta&&hpK()<=0){
      koDone=true;
      const remCount=st.filter(v=>v===null).length;
      const bonus=remCount*100;
      se.score+=bonus;
      for(let k=0;k<n;k++){
        if(st[k]===null){st[k]='bonus';const el=$(`.tile[data-i="${k}"]`);if(el){el.className='tile ok';el.textContent='★';el.disabled=true}}
      }
      hud();
      setTimeout(fxKO,hits===10&&r.status==='correct'?1100:250);
      setTimeout(fxWin,hits===10&&r.status==='correct'?1300:450);
      $('#qh').insertAdjacentHTML('beforeend',`<div class="fb ok" style="margin-top:8px">🏆 ${esc(SYV[se.cur].n)} KO! Bonus ${remCount} sisa soal: +${bonus} poin!</div>`);
      $$('.tile').forEach(x=>x.disabled=true);drawCards();
      await sleep(1800);if(!isRunValid(run))return;return endBundle();
    }

    if(peserta&&hpH()<=0){
      koDone=true;
      fxHeroKO();
      const remCount=st.filter(v=>v===null).length;
      const pen=-(remCount*100);
      se.score+=pen;
      for(let k=0;k<n;k++){
        if(st[k]===null){st[k]='ko';const el=$(`.tile[data-i="${k}"]`);if(el){el.className='tile no';el.textContent='💀';el.disabled=true}}
      }
      hud();
      $('#qh').insertAdjacentHTML('beforeend',`<div class="fb no" style="margin-top:8px">💀 Kamu KO! ${remCount} sisa soal dikunci (${pen} poin).</div>`);
      $$('.tile').forEach(x=>x.disabled=true);drawCards();
      await sleep(1800);if(!isRunValid(run))return;return endBundle();
    }

    $$('.tile').forEach((x,k)=>x.disabled=st[k]!==null);drawCards();
    if(answered===n){await sleep(1600);if(!isRunValid(run))return;endBundle()}
  };
  function endBundle(){
    if(!isRunValid(run))return;
    if(peserta){screens['pes-res']()}
    else{se.done.push(se.cur);cards={};
      if(se.done.length<2){setInGame(false,null);toast('Bundle selesai! Kartu Hikmah terisi lagi. Pilih 1 bundle lagi.');go('umum-list')}
      else{screens['umum-res']()}}
  }
}

// Layar hasil Peserta & Umum
function resultBase(se,total){
  const nilai=pct(se.correct,total);
  return {nilai,win:nilai>=70};
}
screens['pes-res']=()=>{
  const se=S.sess,{nilai,win}=resultBase(se,10);Music.auto(5);afterFinish();
  const rec=boardAdd('peserta',{name:se.name,av:se.av,score:se.score,time:Math.round(se.time),nilai});
  const cnt=boardGet().peserta.length;if(cnt>=3){unlock('boss')}
  se.nilai=nilai;se.rec=rec;
  if(win){Music.sfx('win');confetti()}
  app.innerHTML=`<div class="stack center"><div class="card pop slide"><div class="big">${win?'🏆':'🌱'}</div><h2>${win?'Syaitan tumbang! Kamu hebat!':'Syaitan mundur, tapi kamu berani!'}</h2>
