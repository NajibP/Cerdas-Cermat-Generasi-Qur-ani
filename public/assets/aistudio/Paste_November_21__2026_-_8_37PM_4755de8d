// Pemilihan & pengacakan soal serta papan skor
function pick(spec,used=S.used,excludeIds=new Set()){
  const out=[];
  for(const [t,n] of Object.entries(spec)){
    let pool=BANK.filter(q=>q.t===t&&!out.includes(q)&&!excludeIds.has(q.id));
    if(pool.length<n){pool=BANK.filter(q=>q.t===t&&!out.includes(q))}
    let fresh=pool.filter(q=>!used.has(q.id));
    if(fresh.length<n){pool.forEach(q=>used.delete(q.id));fresh=pool.filter(q=>!out.includes(q))}
    shuffle(fresh).slice(0,n).forEach(q=>{out.push(q);used.add(q.id)});
  }
  return shuffle(out);
}
function prep(q){
  const idx=[0,1,2,3];
  const numeric=q.o.every(o=>/^\d+$/.test(o));
  const order=numeric?idx:shuffle(idx);
  return {...q,o:order.map(i=>q.o[i]),a:order.indexOf(q.a)};
}

const cmp=(a,b)=>b.score-a.score||a.time-b.time||a.at-b.at;
function boardGet(){return store.get('board',{peserta:[],umum:[],regu:[]})}
function boardAdd(list,e){
  const b=boardGet();e.at=Date.now();
  if(list==='regu'){b.regu.unshift(e);b.regu=b.regu.slice(0,10);store.set('board',b);return {kept:true,rank:0}}
  let arr=b[list];arr.push(e);arr.sort(cmp);
  let kept=true;
  if(arr.length>10){const drop=arr.pop();kept=drop!==e}
  b[list]=arr;store.set('board',b);
  return {kept,rank:arr.indexOf(e)+1};
}
