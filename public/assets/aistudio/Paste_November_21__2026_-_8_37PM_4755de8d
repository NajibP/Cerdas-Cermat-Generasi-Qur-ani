<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Cerdas Cermat: Generasi Qur'ani</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@600;700;800;900&display=swap">
<style>
:root{
  --bg:#FFFFFF; --bg2:#F7F7F7; --surface:#FFFFFF; --surface2:#F7F7F7;
  --ink:#4B4B4B; --muted:#777777; --line:#E5E5E5;
  --primary:#58CC02; --primary-d:#58A700; --primary-ink:#FFFFFF;
  --sun:#FFC800; --sun-d:#E5B400; --sun-ink:#5A4300;
  --coral:#FF4B4B; --coral-d:#EA2B2B;
  --violet:#1CB0F6; --violet-d:#1899D6;
  --good:#58A700; --bad:#EA2B2B; --ok-bg:#D7FFB8; --ok-t:#46A302; --no-bg:#FFDFE0; --no-t:#EA2B2B;
  --f-display:'Nunito','Trebuchet MS',system-ui,sans-serif;
  --f-body:'Nunito',system-ui,-apple-system,'Segoe UI',sans-serif;
  color-scheme:light;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#131F24; --bg2:#1A2A31; --surface:#1F2F36; --surface2:#24363E;
  --ink:#DCE6EC; --muted:#9DB0BA; --line:#37464F;
  --primary-ink:#0F2A00; --sun-ink:#3A2A00;
  --ok-bg:#24400F; --ok-t:#89E219; --no-bg:#40201F; --no-t:#FF8A8A; --good:#89E219; --bad:#FF8A8A; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#131F24; --bg2:#1A2A31; --surface:#1F2F36; --surface2:#24363E;
  --ink:#DCE6EC; --muted:#9DB0BA; --line:#37464F;
  --primary-ink:#0F2A00; --sun-ink:#3A2A00;
  --ok-bg:#24400F; --ok-t:#89E219; --no-bg:#40201F; --no-t:#FF8A8A; --good:#89E219; --bad:#FF8A8A; color-scheme:dark}

*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px);min-height:100%}
body{min-height:100%;background:var(--bg);color:var(--ink);font:700 16px/1.5 var(--f-body);margin:0;padding-block:20px 44px;
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
img{max-width:100%}
[hidden]:not([hidden=until-found i]){display:none!important}
h1,h2,h3{font-family:var(--f-display);line-height:1.15;margin:0;text-wrap:balance;font-weight:900}
h1{font-size:clamp(1.9rem,6vw,2.8rem)} h2{font-size:clamp(1.4rem,4.4vw,1.9rem)} h3{font-size:1.15rem}
p{margin:0 0 .6em} .muted{color:var(--muted)} .small{font-size:.86rem}
.wrap{max-width:760px;margin:0 auto;min-width:0}
.stack{display:flex;flex-direction:column;gap:16px;min-width:0}
.row{display:flex;flex-wrap:wrap;gap:10px;align-items:center;min-width:0}
.grid{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(min(100%,230px),1fr))}
.center{text-align:center} .hide{display:none!important} .tnum{font-variant-numeric:tabular-nums}
.av-svg{display:inline-block;vertical-align:middle;flex:none}

#top{position:static;background:var(--bg);border-bottom:2px solid var(--line);
  margin:0 calc(-1*max(16px,env(safe-area-inset-left,0px))) 18px;padding:8px max(16px,env(safe-area-inset-right,0px)) 8px max(16px,env(safe-area-inset-left,0px))}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:30;background:var(--bg)}
#top .in{max-width:760px;margin:0 auto;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.brand{font-family:var(--f-display);font-weight:900;font-size:1.15rem;margin-right:auto;display:flex;gap:8px;align-items:center;color:var(--primary)}
.brand i{font-style:normal;background:var(--primary);color:#fff;border-radius:10px;padding:2px 8px;font-size:.9rem}

.btn{--d:var(--primary-d);font:900 .95rem var(--f-display);text-transform:uppercase;letter-spacing:.06em;border:0;border-radius:16px;padding:13px 20px;cursor:pointer;
  background:var(--primary);color:var(--primary-ink);box-shadow:0 4px 0 var(--d);transition:transform .08s,box-shadow .08s;
  display:inline-flex;gap:8px;align-items:center;justify-content:center;text-decoration:none;min-height:46px}
.btn:hover:not([disabled]){filter:brightness(1.06)} .btn:active:not([disabled]){transform:translateY(4px);box-shadow:0 0 0 var(--d)}
.btn.sun{background:var(--sun);color:var(--sun-ink);--d:var(--sun-d)} .btn.coral{background:var(--coral);color:#fff;--d:var(--coral-d)}
.btn.violet{background:var(--violet);color:#fff;--d:var(--violet-d)}
.btn.ghost{background:var(--surface);color:var(--violet);border:2px solid var(--line);--d:var(--line);padding:11px 18px}
.btn.sm{padding:7px 12px;min-height:38px;font-size:.78rem;border-radius:12px}
.btn.lg{padding:16px 28px;font-size:1.05rem;width:100%}
.btn[disabled],.btn[aria-disabled="true"]{opacity:.5;cursor:not-allowed;filter:grayscale(.5)}
:focus-visible{outline:3px solid var(--violet);outline-offset:2px}

.card{background:var(--surface);border:2px solid var(--line);border-radius:18px;padding:18px;min-width:0}
.card.pop{box-shadow:0 4px 0 var(--line)}
.tag{display:inline-block;font:900 .7rem var(--f-display);letter-spacing:.08em;text-transform:uppercase;padding:3px 10px;border-radius:99px;background:var(--surface2);border:2px solid var(--line);color:var(--muted)}
.tag.mudah{background:#D7FFB8;color:#3F8F00;border-color:#B5EE86}
.tag.sedang{background:#FFF0B8;color:#8A6500;border-color:#F5D96B}
.tag.sulit{background:#FFDFE0;color:#C92222;border-color:#FFB4B6}
label{display:block;font:800 .9rem var(--f-display);margin-bottom:4px}
input[type=text],input[type=password],textarea,select{width:100%;font:700 1rem var(--f-body);color:var(--ink);background:var(--surface2);border:2px solid var(--line);border-radius:14px;padding:12px 14px;min-height:48px}
input:focus,textarea:focus,select:focus{border-color:var(--violet);outline:0}
textarea{min-height:110px;resize:vertical}
.err{color:var(--bad);font-weight:800;min-height:1.4em}
.locked{opacity:.5;filter:grayscale(.8);pointer-events:none}
.list{margin:0;padding-left:1.2em} .list li{margin:.3em 0}
.law{font-size:.9rem;border-left:6px solid var(--sun);padding-left:12px}

.hero{text-align:center;padding:26px 8px 6px}
.hero .bism{color:var(--primary);margin-bottom:6px}
.hero .by{color:var(--muted)}
.mascot{width:120px;height:120px;margin:0 auto 6px;display:block;animation:bob 2.4s ease-in-out infinite}
@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
.mode{display:flex;gap:14px;align-items:center;text-align:left;width:100%;cursor:pointer;font:inherit;color:inherit;transition:transform .08s,box-shadow .08s}
.mode .ic{font-size:2.2rem;width:62px;height:62px;border-radius:16px;display:grid;place-items:center;flex:none;background:var(--surface2)}
.mode h3{margin-bottom:2px}
.mode:hover:not(.locked):not([disabled]){background:var(--surface2)} .mode:active:not(.locked):not([disabled]){transform:translateY(4px);box-shadow:0 0 0 var(--line)}
.badge-vs{background:var(--coral);color:#fff;border-radius:99px;padding:2px 10px;font:900 .7rem var(--f-display);margin-left:6px;letter-spacing:.06em}

.avs{display:grid;grid-template-columns:repeat(auto-fill,minmax(64px,1fr));gap:8px}
.av{background:var(--surface2);border:2px solid var(--line);border-radius:18px;padding:4px;cursor:pointer;display:grid;place-items:center;box-shadow:0 3px 0 var(--line)}
.av[aria-pressed=true]{border-color:var(--violet);background:#DDF4FF;box-shadow:0 3px 0 var(--violet-d)}
:root[data-theme="dark"] .av[aria-pressed=true]{background:#17384A}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .av[aria-pressed=true]{background:#17384A}}

.music-box{background:var(--surface2);border:2px solid var(--line);border-radius:16px;padding:12px;display:flex;flex-direction:column;gap:10px}
.music-box .tk-row{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.music-box .tk{font:800 .82rem var(--f-display);border:2px solid var(--line);background:var(--surface);color:var(--ink);border-radius:12px;min-width:42px;min-height:38px;cursor:pointer;padding:0 8px;display:inline-flex;align-items:center;justify-content:center;gap:2px}
.music-box .tk[aria-pressed=true]{background:var(--primary);color:var(--primary-ink);border-color:var(--primary-d)}
.music-box .tk.lk{opacity:.5;cursor:not-allowed}
.music-box .nm{font:800 .82rem var(--f-body);color:var(--muted)}
.music-box input[type=range]{flex:1;min-width:120px;accent-color:var(--primary)}

#toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(24px + env(safe-area-inset-bottom,0px));z-index:40;background:var(--ink);color:var(--bg);padding:10px 18px;border-radius:14px;font-weight:800;max-width:90vw;text-align:center}

.hud{display:flex;flex-wrap:wrap;gap:8px;align-items:center;justify-content:space-between}
.pill{background:var(--surface);border:2px solid var(--line);border-radius:99px;padding:3px 12px 3px 6px;font:900 .95rem var(--f-display);display:inline-flex;gap:6px;align-items:center}
.pill.hot{background:var(--sun);color:var(--sun-ink);border-color:var(--sun-d);animation:pulse .8s infinite alternate}
.tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(54px,1fr));gap:8px}
.tile{font:900 1.15rem var(--f-display);aspect-ratio:1;border-radius:16px;border:2px solid var(--line);background:var(--surface);color:var(--violet);cursor:pointer;box-shadow:0 4px 0 var(--line)}
.tile:active:not(:disabled){transform:translateY(4px);box-shadow:none}
.tile:disabled{cursor:not-allowed}
.tile.on{background:var(--sun);border-color:var(--sun-d);color:var(--sun-ink);box-shadow:0 4px 0 var(--sun-d)}
.tile.ok{background:var(--primary);border-color:var(--primary-d);color:#fff;box-shadow:0 4px 0 var(--primary-d)}
.tile.no{background:var(--coral);border-color:var(--coral-d);color:#fff;box-shadow:0 4px 0 var(--coral-d)}
.tile.to{background:var(--muted);border-color:var(--muted);color:var(--surface);box-shadow:none}
.qtext{font:800 clamp(1.1rem,3.6vw,1.35rem)/1.45 var(--f-body)}
.opts{display:grid;gap:10px}
.opt{display:flex;gap:12px;align-items:flex-start;text-align:left;font:800 1rem/1.4 var(--f-body);color:var(--ink);background:var(--surface);
  border:2px solid var(--line);border-radius:16px;padding:12px 14px;cursor:pointer;min-height:54px;box-shadow:0 3px 0 var(--line)}
.opt b{flex:none;width:30px;height:30px;border-radius:10px;border:2px solid var(--line);display:grid;place-items:center;font-family:var(--f-display);color:var(--muted)}
.opt:hover:not(:disabled){background:var(--surface2);border-color:var(--violet)}
.opt:active:not(:disabled){transform:translateY(3px);box-shadow:none}
.opt:disabled{cursor:default}
.opt.right{background:var(--ok-bg);border-color:var(--primary);color:var(--ok-t);box-shadow:0 3px 0 var(--primary)}
.opt.wrong{background:var(--no-bg);border-color:var(--coral);color:var(--no-t);box-shadow:0 3px 0 var(--coral)}
.opt.gone{opacity:.25;text-decoration:line-through}
.opt.picked{border-color:var(--violet);background:#DDF4FF;color:#1480B5}
.timer{height:16px;border-radius:99px;background:var(--line);overflow:hidden}
.timer i{display:block;height:100%;background:var(--primary);width:100%;transition:width .2s linear;border-radius:99px;box-shadow:inset 0 5px 0 rgba(255,255,255,.28)}
.timer.low i{background:var(--coral)} .timer.frenzy i{background:var(--sun)}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:8px}
.hk{font:900 .9rem var(--f-display);border-radius:16px;border:2px solid var(--line);background:var(--surface);color:var(--ink);padding:9px 12px;cursor:pointer;text-align:left;box-shadow:0 3px 0 var(--line)}
.hk small{display:block;font:700 .75rem var(--f-body);color:var(--muted)}
.hk:disabled{opacity:.45;cursor:not-allowed}
.hk.armed{border-color:var(--violet);background:#DDF4FF;color:#1480B5}
.fb{font:900 1.05rem var(--f-display);padding:12px 14px;border-radius:14px}
.fb.ok{background:var(--ok-bg);color:var(--ok-t)} .fb.no{background:var(--no-bg);color:var(--no-t)}

.stage{position:relative;border-radius:22px;border:2px solid var(--line);overflow:hidden;aspect-ratio:16/10;min-height:230px;max-height:420px;width:100%;isolation:isolate;background:#8EDBFF}
.stage .scene{position:absolute;inset:0;width:100%;height:100%;z-index:0}
.stage .cloud{animation:drift 40s linear infinite}
@keyframes drift{from{transform:translateX(-80px)}to{transform:translateX(640px)}}
.stage .bars{position:absolute;left:10px;right:10px;top:8px;display:flex;justify-content:space-between;gap:12px;z-index:6}
.hp{flex:1;max-width:46%;min-width:0}
.hp span{display:block;font:900 .8rem var(--f-display);color:#fff;text-shadow:0 1px 3px rgba(0,0,0,.6)}
.hp div{height:14px;background:rgba(0,0,0,.35);border-radius:99px;overflow:hidden;border:2px solid #fff}
.hp i{display:block;height:100%;transition:width .6s;background:#58CC02}
.hp.k i{background:#FF4B4B}
.fighter{position:absolute;bottom:13%;z-index:3}
.hero-f{left:7%;width:clamp(86px,22%,150px)}
.hero-f .hb{animation:bobh 1.6s ease-in-out infinite}
.hero-f svg{width:100%;height:auto;display:block}
.hero-f .qbook{position:absolute;right:-14%;bottom:6%;width:46%;animation:bobh 1.6s ease-in-out infinite .3s}
.kaiju{right:2%;width:clamp(130px,38%,270px)}
.kaiju.mega-k{width:clamp(160px,48%,340px);bottom:11%}
.kaiju svg{width:100%;height:auto;display:block;overflow:visible}
.kz *{transform-box:fill-box}
.k-body{transform-origin:50% 100%;animation:breathe 2.4s ease-in-out infinite}
.k-head{transform-origin:70% 90%;animation:headbob 2.4s ease-in-out infinite}
.k-tail{transform-origin:0% 60%;animation:tail 1.6s ease-in-out infinite alternate}
.k-arm{transform-origin:90% 20%;animation:armw 1s ease-in-out infinite alternate}
.k-wing{transform-origin:20% 90%;animation:flap .8s ease-in-out infinite alternate}
.k-wing.w2{animation-delay:.15s}
.k-jaw{transform-origin:85% 10%}
.k-xeye,.dizzy,.k-fire{opacity:0}
.k-glow{animation:glow 1.2s ease-in-out infinite alternate}
@keyframes breathe{50%{transform:scale(1.025,1.04)}}
@keyframes headbob{50%{transform:translateY(-3px) rotate(-1.5deg)}}
@keyframes tail{from{transform:rotate(-7deg)}to{transform:rotate(9deg)}}
@keyframes armw{from{transform:rotate(-10deg)}to{transform:rotate(12deg)}}
@keyframes flap{from{transform:rotate(8deg) scaleY(.92)}to{transform:rotate(-14deg) scaleY(1.05)}}
@keyframes glow{from{opacity:.5}to{opacity:1}}
@keyframes bobh{50%{transform:translateY(-5px)}}
@keyframes pulse{to{transform:scale(1.05)}}
.fx-lunge{animation:lunge .55s}
@keyframes lunge{0%,100%{transform:translateX(0)}35%{transform:translateX(-14px) rotate(-5deg)}70%{transform:translateX(26px) rotate(4deg)}}
.hero-f.fx-hit{animation:hhit .55s}
@keyframes hhit{0%,100%{transform:translateX(0);filter:none}20%{transform:translateX(-20px) rotate(-10deg);filter:brightness(1.8) saturate(.5)}55%{transform:translateX(8px)}}
.kaiju.fx-hit{animation:khit .55s}
@keyframes khit{0%,100%{transform:translateX(0);filter:none}15%{transform:translateX(22px) rotate(5deg);filter:brightness(2.3)}50%{transform:translateX(-8px) rotate(-3deg)}}
.kaiju.fx-hit .k-xeye{animation:xeye .55s}
@keyframes xeye{0%,100%{opacity:0}10%,80%{opacity:1}}
.kaiju.atk{animation:katk .7s}
@keyframes katk{0%,100%{transform:translateX(0)}30%{transform:translateX(18px) rotate(3deg)}60%{transform:translateX(-50px) rotate(-4deg)}}
.kaiju.atk .k-jaw{animation:jaw .7s}
@keyframes jaw{0%,100%{transform:rotate(0)}35%,65%{transform:rotate(26deg)}}
.kaiju.atk .k-fire{animation:xeye .7s}
.kaiju.fx-ko{animation:ko 1.1s forwards}
@keyframes ko{0%{transform:translateX(0)}30%{transform:translateX(30px) rotate(10deg);filter:brightness(2)}100%{transform:translate(4px,34px) rotate(72deg);filter:saturate(.5)}}
.kaiju.fx-ko .dizzy{animation:dz 1.1s forwards .8s}
@keyframes dz{to{opacity:1}}
.orb{position:absolute;bottom:34%;left:22%;width:46px;height:46px;z-index:4;animation:orb .45s ease-in forwards}
.orb svg{width:100%;height:100%;animation:spin .45s linear infinite}
@keyframes orb{from{left:22%;transform:scale(.6)}to{left:62%;transform:scale(1.5)}}
@keyframes spin{to{transform:rotate(360deg)}}
.burst{position:absolute;bottom:32%;left:64%;width:90px;height:90px;z-index:5;animation:burst .5s ease-out forwards;pointer-events:none}
@keyframes burst{from{transform:scale(.2);opacity:1}to{transform:scale(1.6);opacity:0}}
.flame{position:absolute;bottom:30%;left:58%;width:70px;height:46px;z-index:4;animation:flame .55s ease-in forwards}
@keyframes flame{from{left:58%;transform:scale(.6)}to{left:20%;transform:scale(1.4)}}
.crowd{position:absolute;left:0;right:0;bottom:0;display:flex;justify-content:space-around;z-index:4;height:13%;align-items:flex-end;overflow:hidden}
.crowd .av-svg{animation:sway 1.6s ease-in-out infinite;margin-bottom:-14px}
.crowd .av-svg:nth-child(2n){animation-delay:.4s}.crowd .av-svg:nth-child(3n){animation-delay:.8s}
.stage.win .crowd .av-svg{animation:cheer .45s ease-in-out infinite;margin-bottom:-6px}
@keyframes sway{50%{transform:translateY(-4px)}}
@keyframes cheer{50%{transform:translateY(-14px)}}
.float{position:absolute;left:50%;top:38%;font:900 1.8rem var(--f-display);color:#fff;text-shadow:0 2px 0 rgba(0,0,0,.45);animation:fl 1s forwards;z-index:7;pointer-events:none}
@keyframes fl{to{transform:translateY(-60px);opacity:0}}
.confetti{position:fixed;inset:0;pointer-events:none;overflow:hidden;z-index:35}
.confetti span{position:absolute;top:-30px;font-size:1.6rem;animation:fall 3.2s linear forwards}
@keyframes fall{to{transform:translateY(110vh) rotate(540deg)}}

.bracket{display:flex;gap:18px;overflow-x:auto;padding-bottom:8px}
.rd{display:flex;flex-direction:column;justify-content:space-around;gap:12px;min-width:190px}
.rd h4{margin:0;font:900 .8rem var(--f-display);text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}
.mt{background:var(--surface);border:2px solid var(--line);border-radius:16px;padding:6px}
.mt.cur{border-color:var(--sun-d);box-shadow:0 4px 0 var(--sun-d)}
.mt .pl{display:flex;gap:6px;align-items:center;padding:4px 8px;border-radius:10px;font:800 .95rem var(--f-display)}
.mt .pl.w{background:var(--primary);color:#fff}
.mt .pl.l{opacity:.5;text-decoration:line-through}
.mt .pl em{font:700 .7rem var(--f-body);margin-left:auto;font-style:normal;opacity:.8}

.tabs{display:flex;gap:8px;flex-wrap:wrap}
.tabs .btn[aria-pressed=true]{background:#DDF4FF;border-color:var(--violet)}
.tbl{width:100%;border-collapse:collapse}
.tbl th,.tbl td{padding:9px 8px;text-align:left;border-bottom:2px solid var(--line);font-variant-numeric:tabular-nums}
.tbl th{font:900 .75rem var(--f-display);text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}
.tbl td .av-svg{margin-right:6px}
.tbl tr.top td:first-child{font-size:1.3rem}
.tbl tr.low td{color:var(--bad)}
.scroll-x{overflow-x:auto}

.cert-img{width:100%;height:auto;border-radius:16px;border:2px solid var(--line);display:block}
.slide{min-height:300px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;text-align:center;padding:26px 14px}
.big{font-size:clamp(3.6rem,11vw,5.2rem);line-height:1.1;display:inline-block;will-change:transform;animation:bob 2.4s ease-in-out infinite}
.dots{display:flex;gap:8px;justify-content:center}
.dots i{width:12px;height:12px;border-radius:50%;background:var(--line)} .dots i.on{background:var(--primary);transform:scale(1.3)}
.title-btn{font:900 clamp(2rem,9vw,3.6rem)/1.05 var(--f-display);background:var(--surface);border:2px solid var(--line);border-radius:28px;
  padding:34px 22px;color:var(--ink);cursor:pointer;box-shadow:0 6px 0 var(--primary-d);animation:bob 2s ease-in-out infinite;width:100%}
.title-btn span{display:block;color:var(--primary)}
.bell{font-size:3rem;min-height:130px;flex:1;border-radius:24px}
@media (prefers-reduced-motion:reduce){*{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}

.sw{position:relative;width:42px;height:22px;border-radius:99px;background:var(--line);display:inline-block;transition:background .25s;flex:none}
.sw::after{content:"";position:absolute;top:3px;left:3px;width:16px;height:16px;border-radius:50%;background:#fff;box-shadow:0 1px 2px rgba(0,0,0,.3);transition:transform .25s}
[aria-checked=true]>.sw{background:var(--primary)} [aria-checked=true]>.sw::after{transform:translateX(20px)}
