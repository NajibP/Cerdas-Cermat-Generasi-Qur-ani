// Komponen pertanyaan berwaktu
function ask(host,q,opts={}){
  const L='ABCD';let left=opts.seconds||60,total=left,rate=opts.rate||1,done=false,t0=performance.now(),last=t0;
  const reveal=opts.reveal!==false, hidden=new Set(opts.hide||[]);
  host.innerHTML=`<div class="stack"><div class="timer" id="tm"><i></i></div>
    <div class="row" style="justify-content:space-between"><span class="pill tnum">⏱ <span id="tl">${Math.ceil(left)}</span> dtk</span><span id="tinfo" class="small muted"></span></div>
    <div class="qtext">${esc(q.q)}</div>
    <div class="opts">${q.o.map((o,i)=>`<button class="opt${hidden.has(i)?' gone':''}" data-i="${i}" ${hidden.has(i)?'disabled':''}><b>${L[i]}</b><span>${esc(o)}</span></button>`).join('')}</div>
    <div id="fb"></div></div>`;
  let res;const promise=new Promise(r=>res=r);
  const bar=$('#tm i',host),tm=$('#tm',host),tl=$('#tl',host);
  function finish(status,picked){
    if(done)return;done=true;clearInterval(iv);
    const elapsed=(performance.now()-t0)/1000;
    $$('.opt',host).forEach((b,i)=>{b.disabled=true;if(reveal){if(i===q.a)b.classList.add('right');else if(i===picked)b.classList.add('wrong')}else if(i===picked)b.classList.add('picked')});
    res({status,picked,elapsed:Math.min(elapsed,total)});
  }
  host.onclick=e=>{const b=e.target.closest('.opt');if(!b||done||b.disabled)return;const i=+b.dataset.i;finish(i===q.a?'correct':'wrong',i)};
  const iv=setInterval(()=>{
    if(done){clearInterval(iv);return}
    const now=performance.now(),dt=(now-last)/1000;last=now;left-=dt*rate;
    if(left<=0){left=0;finish('timeout',-1)}
    if(bar)bar.style.width=Math.max(0,left/total*100)+'%';
    if(tm){tm.classList.toggle('low',left<10);tm.classList.toggle('frenzy',rate<1)}
    if(tl)tl.textContent=Math.ceil(left);
  },200);
  return {promise,
    addTime(s){if(!done){left+=s;total=Math.max(total,left)}},
    eliminate(){
      if(done)return;
      const wrong=shuffle([0,1,2,3].filter(i=>i!==q.a&&!hidden.has(i))).slice(0,2);
      wrong.forEach(i=>{
        hidden.add(i);
        const b=$(`.opt[data-i="${i}"]`,host);
        if(b){b.classList.add('gone');b.disabled=true}
      });
    },
    setRate(r){rate=r},
    stop(){if(!done){done=true;clearInterval(iv)}}
  };
}
