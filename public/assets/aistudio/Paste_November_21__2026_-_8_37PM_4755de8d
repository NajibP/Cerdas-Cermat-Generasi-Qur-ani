    <div class="card"><label for="tsz">Jumlah pemain</label><select id="tsz"><option value="4">4 pemain</option><option value="8">8 pemain</option></select></div>
    <div class="grid" id="pf"></div><div class="err" id="er" role="alert"></div><button class="btn lg" id="st">Undi bagan 🎲</button></div>`;
  draw(4);$('#tsz').onchange=e=>draw(+e.target.value);
  $('#st').onclick=()=>{const n=+$('#tsz').value,pl=[];
    for(let i=0;i<n;i++){const nm=cleanName($('#tn'+i).value);if(!nm){$('#er').textContent='Semua nama pemain harus diisi.';return}pl.push({name:nm,k:$('#tk'+i).value,av:$('#tav'+i).dataset.v})}
    if(new Set(pl.map(p=>p.name.toLowerCase())).size<n){$('#er').textContent='Nama pemain tidak boleh sama.';return}
